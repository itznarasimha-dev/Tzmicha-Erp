# =============================================================================
# Totally ERP API Server — Environment Template
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `server/.env` for local backend development.
# 2. Fill in real values for your environment.
# 3. NEVER commit `server/.env` or any production secrets to Git.
# =============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=4000
API_PREFIX=/api
LOG_LEVEL=info

# Cross-Origin Resource Sharing (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL)
# -----------------------------------------------------------------------------
# 1. DATABASE_URL: Transaction pooler (Port 6543) via PgBouncer.
#    Use this for high-concurrency runtime application queries.
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=erp

# 2. DIRECT_URL: Direct session connection (Port 5432).
#    Required for DDL migrations, schema changes, and pg_dump backups.
DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres?schema=erp

# Connection pool settings
DB_SSL=true
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# Row-Level Security (RLS) enforcement
DB_ENFORCE_RLS=true
DB_RLS_ROLE=authenticated

# -----------------------------------------------------------------------------
# Supabase Authentication & Security
# -----------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Supabase JWT Secret (Project Settings -> API -> JWT Secret)
# Used for symmetric HS256 verification (leave blank to verify asymmetric JWKS via SUPABASE_URL)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder-minimum-32-chars

# Supabase Service Role Key (Server-to-server operations ONLY - never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# -----------------------------------------------------------------------------
# Storage & Buckets
# -----------------------------------------------------------------------------
SUPABASE_STORAGE_BUCKET=erp-documents

# -----------------------------------------------------------------------------
# Email / SMTP Notifications (Transactional Alerts, Approvals)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-api-key-placeholder
SMTP_FROM=no-reply@apexflow-erp.com

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
