# ---------------------------------------------------------------------------
# Totally ERP API — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PREFIX=/api
LOG_LEVEL=info

# Comma-separated list of allowed browser origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# --- Database ---------------------------------------------------------------
# Prefer a direct/pooled Postgres connection string. Use the *pooler* host for
# serverless deployments.
DATABASE_URL=postgresql://postgres:password@db.<project-ref>.supabase.co:5432/postgres
DB_SSL=true
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# Enforce Postgres RLS by switching the request transaction to this role.
# Keep this TRUE in every environment. Only a local developer may disable it
# temporarily, and the server logs a warning when it is off.
DB_ENFORCE_RLS=true
DB_RLS_ROLE=authenticated

# --- Supabase Auth ----------------------------------------------------------
# Used for the issuer and JWKS endpoint.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Legacy symmetric signing secret (Project Settings → API → JWT Secret).
# If omitted, the server verifies asymmetric tokens through the JWKS endpoint.
# SUPABASE_JWT_SECRET=

# NEVER put the service-role key or any secret in the frontend. The API does
# not use a service-role key at all: it forwards the caller's verified identity
# and lets Postgres enforce RLS.
