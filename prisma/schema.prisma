// =====================================================================
//  TZMICHA / APEXFLOW ERP : PRISMA SCHEMA DEFINITION (v1)
//  PostgreSQL 14+ / Supabase Compatible
//  Target Database Schema: "erp"
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["erp"]
}

// =====================================================================
// 1. PLATFORM: TENANTS, PLANS, GEOGRAPHY, RBAC, USERS
// =====================================================================

model Plan {
  code          String         @id
  maxEmployees  Int            @map("max_employees")
  maxRegions    Int            @map("max_regions")
  maxWarehouses Int            @map("max_warehouses")
  features      Json           @default("{}")
  organizations Organization[]

  @@map("plans")
  @@schema("erp")
}

model Organization {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId               String                 @unique @map("team_id")
  name                 String
  legalName            String?                @map("legal_name")
  gstin                String?
  planCode             String                 @default("Professional") @map("plan_code")
  currency             String                 @default("INR") @db.Char(3)
  timezone             String                 @default("Asia/Kolkata")
  fiscalYearStartMonth Int                    @default(4) @map("fiscal_year_start_month")
  enabledModules       String[]               @default(["sales", "marketing", "inventory", "procurement", "finance", "hr", "service"]) @map("enabled_modules")
  settings             Json                   @default("{}")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?              @map("deleted_at") @db.Timestamptz(6)

  plan                 Plan                   @relation(fields: [planCode], references: [code])
  regions              Region[]
  departments          Department[]
  roles                Role[]
  users                User[]
  parties              Party[]
  products             Product[]
  warehouses           Warehouse[]
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  salesOrders          SalesOrder[]
  invoices             Invoice[]
  accounts             Account[]
  journalEntries       JournalEntry[]
  fiscalPeriods        FiscalPeriod[]
  serviceTickets       ServiceTicket[]

  @@map("organizations")
  @@schema("erp")
}

model Region {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String       @map("org_id") @db.Uuid
  code          String
  name          String
  state         String?
  headquarters  String?
  targetRevenue Decimal?     @default(0) @map("target_revenue") @db.Decimal(14, 2)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [orgId], references: [id])
  warehouses    Warehouse[]
  userRegions   UserRegion[]
  parties       Party[]
  salesOrders   SalesOrder[]
  fieldVisits   FieldVisit[]

  @@unique([orgId, code])
  @@map("regions")
  @@schema("erp")
}

model Department {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  code         String
  name         String

  organization Organization @relation(fields: [orgId], references: [id])
  roles        Role[]

  @@unique([orgId, code])
  @@map("departments")
  @@schema("erp")
}

model Role {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String           @map("org_id") @db.Uuid
  departmentId String?          @map("department_id") @db.Uuid
  baseRole     String           @map("base_role")
  code         String
  name         String
  tier         Int              @default(1)
  isSystem     Boolean          @default(false) @map("is_system")

  organization Organization     @relation(fields: [orgId], references: [id])
  department   Department?      @relation(fields: [departmentId], references: [id])
  users        User[]
  permissions  RolePermission[]

  @@unique([orgId, code])
  @@map("roles")
  @@schema("erp")
}

model Permission {
  code        String           @id
  module      String
  description String?
  roles       RolePermission[]

  @@map("permissions")
  @@schema("erp")
}

model RolePermission {
  roleId         String     @map("role_id") @db.Uuid
  permissionCode String     @map("permission_code")

  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
  @@schema("erp")
}

model User {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId              String             @map("org_id") @db.Uuid
  authUserId         String?            @unique @map("auth_user_id") @db.Uuid
  employeeCode       String             @map("employee_code")
  name               String
  email              String             @db.Citext
  phone              String?
  passwordHash       String?            @map("password_hash")
  roleId             String             @map("role_id") @db.Uuid
  reportsToId        String?            @map("reports_to_id") @db.Uuid
  status             String             @default("active")
  maxDiscountPercent Decimal            @default(0) @map("max_discount_percent") @db.Decimal(5, 2)
  monthlySalesTarget Decimal            @default(0) @map("monthly_sales_target") @db.Decimal(14, 2)
  monthlyVisitTarget Int                @default(0) @map("monthly_visit_target")
  allRegions         Boolean            @default(false) @map("all_regions")
  preferences        Json               @default("{}")
  lastLoginAt        DateTime?          @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?            @map("created_by") @db.Uuid
  updatedBy          String?            @map("updated_by") @db.Uuid
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(6)
  version            Int                @default(1)

  organization       Organization       @relation(fields: [orgId], references: [id])
  role               Role               @relation(fields: [roleId], references: [id])
  reportsTo          User?              @relation("Hierarchy", fields: [reportsToId], references: [id])
  subordinates       User[]             @relation("Hierarchy")
  userRegions        UserRegion[]
  profile            EmployeeProfile?
  salesOrders        SalesOrder[]       @relation("SalesUser")
  fieldVisits        FieldVisit[]
  serviceTickets     ServiceTicket[]    @relation("Engineer")

  @@unique([orgId, email])
  @@unique([orgId, employeeCode])
  @@map("users")
  @@schema("erp")
}

model UserRegion {
  userId   String @map("user_id") @db.Uuid
  regionId String @map("region_id") @db.Uuid

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([userId, regionId])
  @@map("user_regions")
  @@schema("erp")
}

// =====================================================================
// 2. SHARED SERVICES: DOCUMENTS, APPROVALS, ATTACHMENTS, AUDIT
// =====================================================================

model DocumentSequence {
  orgId      String @map("org_id") @db.Uuid
  docType    String @map("doc_type")
  fiscalYear String @map("fiscal_year")
  prefix     String
  padding    Int    @default(4)
  nextValue  BigInt @default(1) @map("next_value")

  @@id([orgId, docType, fiscalYear])
  @@map("document_sequences")
  @@schema("erp")
}

model IdempotencyKey {
  orgId       String   @map("org_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  key         String
  requestHash String?  @map("request_hash")
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([orgId, userId, key])
  @@map("idempotency_keys")
  @@schema("erp")
}

model Attachment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id") @db.Uuid
  fileUrl    String    @map("file_url")
  fileName   String?   @map("file_name")
  mimeType   String?   @map("mime_type")
  sizeBytes  BigInt?   @map("size_bytes")
  kind       String?
  uploadedBy String?   @map("uploaded_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([orgId, entityType, entityId])
  @@map("attachments")
  @@schema("erp")
}

model ApprovalRequest {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  requestType    String    @map("request_type")
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id") @db.Uuid
  amount         Decimal?  @db.Decimal(14, 2)
  requestedBy    String    @map("requested_by") @db.Uuid
  requiredRoleId String?   @map("required_role_id") @db.Uuid
  status         String    @default("pending")
  decidedBy      String?   @map("decided_by") @db.Uuid
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote   String?   @map("decision_note")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int       @default(1)

  @@index([orgId, status, requestType])
  @@map("approval_requests")
  @@schema("erp")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  orgId      String?  @map("org_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  userRole   String?  @map("user_role")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  ip         String?  @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orgId, entityType, entityId])
  @@map("audit_logs")
  @@schema("erp")
}

// =====================================================================
// 3. PARTIES: CUSTOMER 360 / SUPPLIERS / PROSPECTS
// =====================================================================

model Party {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String         @map("org_id") @db.Uuid
  code             String
  name             String
  businessName     String?        @map("business_name")
  legalName        String?        @map("legal_name")
  isCustomer       Boolean        @default(false) @map("is_customer")
  isSupplier       Boolean        @default(false) @map("is_supplier")
  isProspect       Boolean        @default(true) @map("is_prospect")
  customerType     String?        @map("customer_type")
  gstin            String?
  pan              String?
  phone            String?
  email            String?        @db.Citext
  normalizedPhone  String?        @map("normalized_phone")
  normalizedEmail  String?        @map("normalized_email")
  regionId         String?        @map("region_id") @db.Uuid
  ownerUserId      String?        @map("owner_user_id") @db.Uuid
  creditLimit      Decimal        @default(0) @map("credit_limit") @db.Decimal(14, 2)
  creditFrozen     Boolean        @default(false) @map("credit_frozen")
  paymentTermsDays Int            @default(0) @map("payment_terms_days")
  status           String         @default("active")
  legacyRef        String?        @map("legacy_ref")
  customFields     Json           @default("{}") @map("custom_fields")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?        @map("created_by") @db.Uuid
  updatedBy        String?        @map("updated_by") @db.Uuid
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(6)
  version          Int            @default(1)

  organization     Organization   @relation(fields: [orgId], references: [id])
  region           Region?        @relation(fields: [regionId], references: [id])
  contacts         PartyContact[]
  addresses        PartyAddress[]
  purchaseOrders   PurchaseOrder[]
  salesOrders      SalesOrder[]
  invoices         Invoice[]
  payments         Payment[]
  equipment        Equipment[]

  @@unique([orgId, code])
  @@index([orgId, normalizedPhone])
  @@index([orgId, normalizedEmail])
  @@map("parties")
  @@schema("erp")
}

model PartyContact {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  partyId   String    @map("party_id") @db.Uuid
  name      String
  designation String?
  phone     String?
  email     String?   @db.Citext
  isPrimary Boolean   @default(false) @map("is_primary")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  party     Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("party_contacts")
  @@schema("erp")
}

model PartyAddress {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  partyId   String    @map("party_id") @db.Uuid
  kind      String
  line1     String
  line2     String?
  city      String?
  state     String?
  pincode   String?
  country   String?   @default("India")
  latitude  Decimal?  @db.Decimal(10, 7)
  longitude Decimal?  @db.Decimal(10, 7)
  isDefault Boolean   @default(false) @map("is_default")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  party     Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("party_addresses")
  @@schema("erp")
}

// =====================================================================
// 4. PRODUCT CATALOG, PRICING & SECRET COSTS
// =====================================================================

model ProductCategory {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String            @map("org_id") @db.Uuid
  parentId  String?           @map("parent_id") @db.Uuid
  name      String

  parent    ProductCategory?  @relation("CatHierarchy", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CatHierarchy")
  products  Product[]

  @@unique([orgId, parentId, name])
  @@map("product_categories")
  @@schema("erp")
}

model Uom {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  code      String
  name      String
  products  Product[]

  @@unique([orgId, code])
  @@map("uoms")
  @@schema("erp")
}

model Product {
  id                        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                     String           @map("org_id") @db.Uuid
  sku                       String
  name                      String
  description               String?
  categoryId                String?          @map("category_id") @db.Uuid
  uomId                     String?          @map("uom_id") @db.Uuid
  productSource             String           @default("supplier_sourced") @map("product_source")
  supplierPartyId           String?          @map("supplier_party_id") @db.Uuid
  manufacturingFacility     String?          @map("manufacturing_facility")
  hsnCode                   String?          @map("hsn_code")
  taxRatePercent            Decimal          @default(18) @map("tax_rate_percent") @db.Decimal(5, 2)
  trackBatches              Boolean          @default(true) @map("track_batches")
  trackExpiry               Boolean          @default(false) @map("track_expiry")
  lowStockThreshold         Int              @default(20) @map("low_stock_threshold")
  defaultMaxDiscountPercent Decimal          @default(10) @map("default_max_discount_percent") @db.Decimal(5, 2)
  promotionalDiscountPercent Decimal         @default(0) @map("promotional_discount_percent") @db.Decimal(5, 2)
  isSellable                Boolean          @default(true) @map("is_sellable")
  isActive                  Boolean          @default(true) @map("is_active")
  customFields              Json             @default("{}") @map("custom_fields")
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy                 String?          @map("created_by") @db.Uuid
  updatedBy                 String?          @map("updated_by") @db.Uuid
  deletedAt                 DateTime?        @map("deleted_at") @db.Timestamptz(6)
  version                   Int              @default(1)

  organization              Organization     @relation(fields: [orgId], references: [id])
  category                  ProductCategory? @relation(fields: [categoryId], references: [id])
  uom                       Uom?             @relation(fields: [uomId], references: [id])
  prices                    ProductPrice[]
  costs                     ProductCost[]
  batches                   Batch[]

  @@unique([orgId, sku])
  @@map("products")
  @@schema("erp")
}

model ProductPrice {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  productId String    @map("product_id") @db.Uuid
  priceList String    @map("price_list") // mrp, standard, dealer, floor
  amount    Decimal   @db.Decimal(12, 2)
  validFrom DateTime  @default(now()) @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  product   Product   @relation(fields: [productId], references: [id])

  @@map("product_prices")
  @@schema("erp")
}

model ProductCost {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  costType      String   @map("cost_type") // supplier, manufacturing
  components    Json     @default("{}")
  totalUnitCost Decimal  @map("total_unit_cost") @db.Decimal(12, 2)
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product       Product  @relation(fields: [productId], references: [id])

  @@map("product_costs")
  @@schema("erp")
}

// =====================================================================
// 5. WAREHOUSES, BATCHES & INVENTORY
// =====================================================================

model Warehouse {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String            @map("org_id") @db.Uuid
  regionId      String?           @map("region_id") @db.Uuid
  code          String
  name          String
  address       String?
  capacitySqFt  Int?              @map("capacity_sq_ft")
  managerId     String?           @map("manager_id") @db.Uuid
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization      @relation(fields: [orgId], references: [id])
  region        Region?           @relation(fields: [regionId], references: [id])
  locations     StorageLocation[]
  batches       Batch[]

  @@unique([orgId, code])
  @@map("warehouses")
  @@schema("erp")
}

model StorageLocation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  code        String
  zone        String?

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  batches     Batch[]

  @@unique([warehouseId, code])
  @@map("storage_locations")
  @@schema("erp")
}

model Batch {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                    String           @map("org_id") @db.Uuid
  batchNumber              String           @map("batch_number")
  productId                String           @map("product_id") @db.Uuid
  warehouseId              String           @map("warehouse_id") @db.Uuid
  storageLocationId        String?          @map("storage_location_id") @db.Uuid
  manufacturingDate        DateTime?        @map("manufacturing_date") @db.Date
  expiryDate               DateTime?        @map("expiry_date") @db.Date
  unitCost                 Decimal?         @map("unit_cost") @db.Decimal(12, 2)
  qtyOnHand                Int              @default(0) @map("qty_on_hand")
  qtyReserved              Int              @default(0) @map("qty_reserved")
  clearanceDiscountPercent Decimal          @default(0) @map("clearance_discount_percent") @db.Decimal(5, 2)
  qcStatus                 String           @default("released") @map("qc_status")
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                  Int              @default(1)

  product                  Product          @relation(fields: [productId], references: [id])
  warehouse                Warehouse        @relation(fields: [warehouseId], references: [id])
  storageLocation          StorageLocation? @relation(fields: [storageLocationId], references: [id])

  @@unique([orgId, productId, warehouseId, batchNumber])
  @@map("batches")
  @@schema("erp")
}

model StockMovement {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  movementType   String   @map("movement_type")
  productId      String   @map("product_id") @db.Uuid
  batchId        String?  @map("batch_id") @db.Uuid
  warehouseId    String   @map("warehouse_id") @db.Uuid
  quantity       Int
  referenceType  String?  @map("reference_type")
  referenceId    String?  @map("reference_id") @db.Uuid
  performedBy    String?  @map("performed_by") @db.Uuid
  remarks        String?
  idempotencyKey String?  @unique @map("idempotency_key")

  @@index([orgId, productId, occurredAt(sort: Desc)])
  @@map("stock_movements")
  @@schema("erp")
}

// =====================================================================
// 6. PROCUREMENT: PO & GRN
// =====================================================================

model PurchaseOrder {
  id                       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                    String              @map("org_id") @db.Uuid
  poNumber                 String              @map("po_number")
  supplierId               String              @map("supplier_id") @db.Uuid
  destinationWarehouseId   String              @map("destination_warehouse_id") @db.Uuid
  orderDate                DateTime            @default(now()) @map("order_date") @db.Date
  expectedDeliveryDate     DateTime?           @map("expected_delivery_date") @db.Date
  subtotal                 Decimal             @default(0) @db.Decimal(14, 2)
  taxAmount                Decimal             @default(0) @map("tax_amount") @db.Decimal(14, 2)
  expectedTransportCharges Decimal             @default(0) @map("expected_transport_charges") @db.Decimal(12, 2)
  totalCost                Decimal             @default(0) @map("total_cost") @db.Decimal(14, 2)
  status                   String              @default("draft")
  createdBy                String?             @map("created_by") @db.Uuid
  approvedBy               String?             @map("approved_by") @db.Uuid
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?           @map("deleted_at") @db.Timestamptz(6)
  version                  Int                 @default(1)

  organization             Organization        @relation(fields: [orgId], references: [id])
  supplier                 Party               @relation(fields: [supplierId], references: [id])
  lines                    PurchaseOrderLine[]

  @@unique([orgId, poNumber])
  @@map("purchase_orders")
  @@schema("erp")
}

model PurchaseOrderLine {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  productId       String        @map("product_id") @db.Uuid
  orderedQty      Int           @map("ordered_qty")
  unitPrice       Decimal       @map("unit_price") @db.Decimal(12, 2)
  taxRatePercent  Decimal       @default(18) @map("tax_rate_percent") @db.Decimal(5, 2)
  lineTotal       Decimal       @map("line_total") @db.Decimal(14, 2)

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_lines")
  @@schema("erp")
}

model GoodsReceipt {
  id                            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                         String             @map("org_id") @db.Uuid
  receiptNumber                 String             @map("receipt_number")
  purchaseOrderId               String?            @map("purchase_order_id") @db.Uuid
  supplierId                    String             @map("supplier_id") @db.Uuid
  supplierInvoiceNumber         String?            @map("supplier_invoice_number")
  warehouseId                   String             @map("warehouse_id") @db.Uuid
  transportExpensePaidByCompany Decimal            @default(0) @map("transport_expense_paid_by_company") @db.Decimal(12, 2)
  status                        String             @default("draft")
  inspectionNotes               String?            @map("inspection_notes")
  receivedBy                    String?            @map("received_by") @db.Uuid
  createdAt                     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization                  Organization       @relation(fields: [orgId], references: [id])
  lines                         GoodsReceiptLine[]

  @@unique([orgId, receiptNumber])
  @@map("goods_receipts")
  @@schema("erp")
}

model GoodsReceiptLine {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId                String        @map("receipt_id") @db.Uuid
  productId                String        @map("product_id") @db.Uuid
  batchNumber              String?       @map("batch_number")
  expectedQty              Int           @map("expected_qty")
  receivedQty              Int           @map("received_qty")
  acceptedQty              Int           @default(0) @map("accepted_qty")
  shortageQty              Int           @default(0) @map("shortage_qty")
  damagedQty               Int           @default(0) @map("damaged_qty")
  actualLandedUnitCost     Decimal?      @map("actual_landed_unit_cost") @db.Decimal(12, 2)

  receipt                  GoodsReceipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@map("goods_receipt_lines")
  @@schema("erp")
}

// =====================================================================
// 7. SALES: ORDERS & INVOICES
// =====================================================================

model SalesOrder {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                    String           @map("org_id") @db.Uuid
  orderNumber              String           @map("order_number")
  partyId                  String           @map("party_id") @db.Uuid
  regionId                 String?          @map("region_id") @db.Uuid
  salesUserId              String           @map("sales_user_id") @db.Uuid
  subtotal                 Decimal          @default(0) @db.Decimal(14, 2)
  totalDiscount            Decimal          @default(0) @map("total_discount") @db.Decimal(14, 2)
  totalTax                 Decimal          @default(0) @map("total_tax") @db.Decimal(14, 2)
  totalAmount              Decimal          @default(0) @map("total_amount") @db.Decimal(14, 2)
  companyTransportExpense  Decimal          @default(0) @map("company_transport_expense") @db.Decimal(12, 2)
  customerDeliveryCharge   Decimal          @default(0) @map("customer_delivery_charge") @db.Decimal(12, 2)
  discountApprovalStatus   String           @default("not_required") @map("discount_approval_status")
  status                   String           @default("draft")
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization             Organization     @relation(fields: [orgId], references: [id])
  party                    Party            @relation(fields: [partyId], references: [id])
  region                   Region?          @relation(fields: [regionId], references: [id])
  salesUser                User             @relation("SalesUser", fields: [salesUserId], references: [id])
  lines                    SalesOrderLine[]
  invoices                 Invoice[]

  @@unique([orgId, orderNumber])
  @@map("sales_orders")
  @@schema("erp")
}

model SalesOrderLine {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salesOrderId    String     @map("sales_order_id") @db.Uuid
  productId       String     @map("product_id") @db.Uuid
  quantity        Int
  standardPrice   Decimal    @map("standard_price") @db.Decimal(12, 2)
  discountPercent Decimal    @default(0) @map("discount_percent") @db.Decimal(5, 2)
  unitPrice       Decimal    @map("unit_price") @db.Decimal(12, 2)
  taxRatePercent  Decimal    @default(18) @map("tax_rate_percent") @db.Decimal(5, 2)
  taxAmount       Decimal    @map("tax_amount") @db.Decimal(12, 2)
  netAmount       Decimal    @map("net_amount") @db.Decimal(14, 2)

  salesOrder      SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@map("sales_order_lines")
  @@schema("erp")
}

model Invoice {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId              String              @map("org_id") @db.Uuid
  invoiceNumber      String              @map("invoice_number")
  partyId            String              @map("party_id") @db.Uuid
  salesOrderId       String?             @map("sales_order_id") @db.Uuid
  invoiceDate        DateTime            @default(now()) @map("invoice_date") @db.Date
  dueDate            DateTime?           @map("due_date") @db.Date
  subtotal           Decimal             @db.Decimal(14, 2)
  totalTax           Decimal             @default(0) @map("total_tax") @db.Decimal(14, 2)
  totalAmount        Decimal             @map("total_amount") @db.Decimal(14, 2)
  status             String              @default("draft")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization        @relation(fields: [orgId], references: [id])
  party              Party               @relation(fields: [partyId], references: [id])
  salesOrder         SalesOrder?         @relation(fields: [salesOrderId], references: [id])
  paymentAllocations PaymentAllocation[]

  @@unique([orgId, invoiceNumber])
  @@map("invoices")
  @@schema("erp")
}

model Payment {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String              @map("org_id") @db.Uuid
  partyId        String              @map("party_id") @db.Uuid
  paymentDate    DateTime            @default(now()) @map("payment_date") @db.Date
  mode           String
  amount         Decimal             @db.Decimal(14, 2)
  referenceNo    String?             @map("reference_no")
  idempotencyKey String              @map("idempotency_key")
  status         String              @default("received")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  party          Party               @relation(fields: [partyId], references: [id])
  allocations    PaymentAllocation[]

  @@unique([orgId, idempotencyKey])
  @@map("payments")
  @@schema("erp")
}

model PaymentAllocation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  amount    Decimal  @db.Decimal(14, 2)

  payment   Payment  @relation(fields: [paymentId], references: [id])
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])

  @@unique([paymentId, invoiceId])
  @@map("payment_allocations")
  @@schema("erp")
}

// =====================================================================
// 8. FINANCE & GENERAL LEDGER
// =====================================================================

model Account {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String             @map("org_id") @db.Uuid
  code         String
  name         String
  accountType  String             @map("account_type")
  category     String?
  isPostable   Boolean            @default(true) @map("is_postable")
  isActive     Boolean            @default(true) @map("is_active")

  organization Organization       @relation(fields: [orgId], references: [id])
  journalLines JournalEntryLine[]

  @@unique([orgId, code])
  @@map("accounts")
  @@schema("erp")
}

model FiscalPeriod {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  label        String
  startDate    DateTime     @map("start_date") @db.Date
  endDate      DateTime     @map("end_date") @db.Date
  status       String       @default("open")

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, label])
  @@map("fiscal_periods")
  @@schema("erp")
}

model JournalEntry {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String             @map("org_id") @db.Uuid
  voucherNumber String             @map("voucher_number")
  entryDate     DateTime           @map("entry_date") @db.Date
  description   String?
  status        String             @default("draft")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization       @relation(fields: [orgId], references: [id])
  lines         JournalEntryLine[]

  @@unique([orgId, voucherNumber])
  @@map("journal_entries")
  @@schema("erp")
}

model JournalEntryLine {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId     String       @map("entry_id") @db.Uuid
  accountId   String       @map("account_id") @db.Uuid
  debit       Decimal      @default(0) @db.Decimal(16, 2)
  credit      Decimal      @default(0) @db.Decimal(16, 2)
  description String?

  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     Account      @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@map("journal_entry_lines")
  @@schema("erp")
}

// =====================================================================
// 9. HR & PAYROLL
// =====================================================================

model EmployeeProfile {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  panNumber         String?   @map("pan_number")
  aadhaarLast4      String?   @map("aadhaar_last4") @db.Char(4)
  bankName          String?   @map("bank_name")
  bankIfsc          String?   @map("bank_ifsc")
  designation       String?
  joiningDate       DateTime? @map("joining_date") @db.Date
  probationEndDate  DateTime? @map("probation_end_date") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user              User      @relation(fields: [userId], references: [id])

  @@map("employee_profiles")
  @@schema("erp")
}

// =====================================================================
// 10. FIELD VISITS & SERVICE ENGINEERING
// =====================================================================

model FieldVisit {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  regionId        String?   @map("region_id") @db.Uuid
  visitDate       DateTime  @map("visit_date") @db.Date
  checkInAt       DateTime? @map("check_in_at") @db.Timestamptz(6)
  checkOutAt      DateTime? @map("check_out_at") @db.Timestamptz(6)
  purpose         String?
  locationAddress String?   @map("location_address")
  status          String    @default("scheduled")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user            User      @relation(fields: [userId], references: [id])
  region          Region?   @relation(fields: [regionId], references: [id])

  @@index([orgId, userId, visitDate])
  @@map("field_visits")
  @@schema("erp")
}

model Equipment {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String          @map("org_id") @db.Uuid
  partyId      String          @map("party_id") @db.Uuid
  serialNumber String          @map("serial_number")

  party        Party           @relation(fields: [partyId], references: [id])
  tickets      ServiceTicket[]

  @@unique([orgId, serialNumber])
  @@map("equipment")
  @@schema("erp")
}

model ServiceTicket {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String     @map("org_id") @db.Uuid
  ticketNumber String     @map("ticket_number")
  equipmentId  String?    @map("equipment_id") @db.Uuid
  title        String
  description  String?
  engineerId   String?    @map("engineer_id") @db.Uuid
  status       String     @default("open")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id])
  equipment    Equipment?   @relation(fields: [equipmentId], references: [id])
  engineer     User?        @relation("Engineer", fields: [engineerId], references: [id])

  @@unique([orgId, ticketNumber])
  @@map("service_tickets")
  @@schema("erp")
}
