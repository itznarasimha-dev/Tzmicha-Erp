# =============================================================================
# Totally ERP Frontend (Vite) — Environment Template
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env.local` for local frontend development.
# 2. Vite ONLY exposes variables prefixed with `VITE_` to client-side browser code.
# 3. NEVER put database passwords, service-role keys, or secrets in this file.
# =============================================================================

# Base URL for the ERP backend API
# - Leave empty to use same-origin `/api` (recommended with Vite dev proxy).
# - Set to `http://localhost:4000` to call the Express backend directly in development.
VITE_API_URL=http://localhost:4000

# Supabase Project URL (Used by client auth session listener)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase Anon / Publishable Key (Browser-safe, public key)
# Do NOT use SUPABASE_SERVICE_ROLE_KEY here.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Storage Bucket Name for attachments & documents
VITE_STORAGE_BUCKET=erp-documents
