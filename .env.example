# =====================================================================
# Supabase PostgreSQL Database Connection Strings
# =====================================================================

# Transaction Pooler (Used by backend APIs & Prisma Client via PgBouncer on port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=erp"

# Session Mode / Direct Connection (Used by Prisma CLI for migrations on port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres?schema=erp"

# Supabase Public API Keys (Used by frontend or serverless functions)
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
