# Frontend (Vite) environment configuration for HR & Marketing
#
# Copy to `.env.local` for local development. Vite only exposes variables
# prefixed with VITE_ to browser code. Never put service-role keys,
# DATABASE_URL, or other server secrets in frontend env files.

# Base URL for the ERP backend API.
# - Leave empty to use same-origin `/api` (recommended with `vite.config` dev proxy).
# - Set to `http://localhost:4000` (or your server origin) to call the backend directly.
VITE_API_URL=

# Supabase project URL, used for browser password sign-in (Auth REST) when
# API-backed mode is enabled. Must match the project configured in `server/.env`.
VITE_SUPABASE_URL=

# Supabase anon/publishable key (browser-safe). Do NOT use the service_role key here.
VITE_SUPABASE_ANON_KEY=
